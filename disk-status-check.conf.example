# 企业微信群机器人 Webhook。未配置时留空；建议 chmod 600 配置文件。
# 示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换为真实key
WECOM_WEBHOOK_URL=""

# Webhook 中显示的主机名；留空时自动使用 hostname -f/hostname。
MONITOR_HOSTNAME=""

# 温度/寿命阈值
SATA_TEMP_WARN=60
NVME_TEMP_WARN=70
NVME_PERCENT_USED_WARN=100

# 默认仅在存在警告/异常时推送；相同告警内容按以下秒数冷却。
NOTIFY_COOLDOWN=3600

# 调试开关：1=每次检测都推送，忽略冷却；生产环境请保持 0。
DEBUG_NOTIFY=0
STATE_FILE="/var/tmp/disk-status-check.state"

# CentOS/RHEL 默认使用此 RPM；Debian 的 DEB/ZIP 均未配置时从它提取二进制。
STORCLI_RPM_URL="https://tools.lcayun.cn/storcli/storcli-007.2310.0000.0000-1.noarch.rpm"

# Debian/Ubuntu 默认使用以下 .deb；也可改为其他直达 URL。
# 优先级：STORCLI_DEB_URL > STORCLI_ZIP_URL > 从上面的 noarch RPM 提取。
STORCLI_DEB_URL="https://tools.lcayun.cn/storcli/storcli_007.2705.0000.0000_all.deb"
STORCLI_ZIP_URL=""

